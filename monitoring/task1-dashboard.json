        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "MongoDB asserts: increase / 5m",
      "description": "Increase in assertions over five minutes. Only mongodb_asserts_total is used to avoid double-counting the same data exposed as mongodb_ss_asserts.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (increase(mongodb_asserts_total{namespace=\"demo\"}[5m]))",
          "legendFormat": "{{type}}",
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Kubernetes event records / 5m",
      "description": "Number of event log records received per namespace over a rolling 5-minute window. Updates to the same Kubernetes Event may produce multiple records. No data means no matching records in that window.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (namespace) (count_over_time({job=\"kubernetes-events\",namespace=~\"${namespace:regex}\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Kubernetes Events",
      "description": "Kubernetes Events collected by Alloy and stored in Loki. Expand a record to inspect its reason, object name and message. Filtered by Workload namespace and the dashboard time range.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
